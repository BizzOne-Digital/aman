MONGODB_URI=mongodb://127.0.0.1:27017/canam_facility
ADMIN_EMAIL=admin@canamfacility.ca
ADMIN_PASSWORD=change-this-before-production
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Gmail SMTP for contact/booking notifications (public site still shows info@canamfacility.ca)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=Canam Facility Services <your-gmail-address@gmail.com>
NOTIFY_EMAIL=your-gmail-address@gmail.com
